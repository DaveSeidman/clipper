{
  "name": "clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "install:vision": "UV_CACHE_DIR=data/.uv-cache uv venv --allow-existing --python 3.12 .venv-videomae && UV_CACHE_DIR=data/.uv-cache uv pip install --python .venv-videomae/bin/python -r requirements-videomae.txt",
    "verify:vision": ".venv-videomae/bin/python server/scripts/extract-videomae-embeddings.py --help",
    "verify": "node server/scripts/self-check.js && npm run build",
    "smoke:api": "node server/scripts/smoke-api.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nanoid": "^5.0.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
